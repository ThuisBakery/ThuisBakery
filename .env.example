# Variable names only — never values. Vercel is the source of truth for preview and
# production; local `.env.local` is a pulled copy via `vercel env pull`.
# See docs/agents/build-conventions.md and ADR-0005.

# Payload's signing secret. Set in Vercel; pulled locally.
PAYLOAD_SECRET=

# Vercel Blob, where uploaded photographs live. Injected by the Blob store connected to the
# project in Vercel; pulled locally. Without it Payload falls back to local disk.
BLOB_READ_WRITE_TOKEN=

# The Inspiration photo's own Blob store (ADR-0006): separate from the Media store above,
# and created as a PRIVATE store (a store's access mode cannot be changed afterwards). Its
# read-write token is set in Vercel under this name by hand, and passed explicitly on every
# call, so it can never be confused with the Media store's. Pulled locally.
INSPIRATION_BLOB_READ_WRITE_TOKEN=

# Resend, for the two Enquiry emails (ADR-0006). Set in Vercel for Production and Preview
# only — never Development — so a pulled `.env.local` has none of these and a local run never
# sends real email: Payload only logs each email, and the Submission records it as not sent.
RESEND_API_KEY=
# The signing secret of the Resend webhook pointed at /next/resend-webhook, for Delivery status.
RESEND_WEBHOOK_SECRET=
# The address both emails come from, on the Resend-verified domain: e.g. hallo@thuisbakery.com.
EMAIL_FROM_ADDRESS=
# Jana's inbox: where each Enquiry goes, and what the customer's acknowledgement replies to.
ENQUIRY_INBOX=

# Postgres. Injected per deployment by the Vercel–Neon integration, which is why these
# are invisible in Vercel's environment settings. NEVER set them by hand there.
# Locally, these hold the long-lived Neon `dev` branch connection strings — the one pair
# that is pasted in by hand, into `.env.local`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Not set by anyone: Vercel provides `VERCEL_PROJECT_PRODUCTION_URL` on every deployment,
# and `src/lib/site.ts` builds canonical and hreflang URLs on it. Unset locally, where
# they fall back to http://localhost:3000.
